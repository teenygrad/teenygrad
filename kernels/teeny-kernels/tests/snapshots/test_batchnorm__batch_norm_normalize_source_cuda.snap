"pub fn batch_norm_normalize_forward < T : Triton, D : Float, const BLOCK_N :\ni32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , weight : T :: Pointer < D >\n, bias : T :: Pointer < D > , mean : T :: Pointer < D > , rstd : T :: Pointer\n< D > , N : i32, C : i32,) where T :: I32Tensor : types :: Tensor < i32, 1 > ,\nT :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nPointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T\n:: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_c =\n    __tile_rem_x % (T :: cdiv(C, 1)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(C, 1)); let tile_n = __tile_rem_x; let __tile_range = T ::\n    arange(0, 1) + tile_c * 1; let in_bounds = __tile_range.lt(C); let offsets\n    = __tile_range + tile_n * (C); let weight = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(weight.add_offsets(__tile_range), Some(in_bounds), None, & [],\n        None, None, None, false,), mask : Some(in_bounds),\n    }; let bias = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(bias.add_offsets(__tile_range), Some(in_bounds), None, & [],\n        None, None, None, false,), mask : Some(in_bounds),\n    }; let mean = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(mean.add_offsets(__tile_range), Some(in_bounds), None, & [],\n        None, None, None, false,), mask : Some(in_bounds),\n    }; let rstd = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(rstd.add_offsets(__tile_range), Some(in_bounds), None, & [],\n        None, None, None, false,), mask : Some(in_bounds),\n    }; let mut __tile_map_n : i32 = 0; while __tile_map_n < (N)\n    {\n        let __tile_map_col = T :: arange(0, BLOCK_N) + __tile_map_n; let\n        __tile_map_mask = __tile_map_col.lt(N); let tile_walk =\n        __tile_map_col; let tile_walk_mask = __tile_map_mask; let x = T ::\n        load(x.add_offsets((__tile_map_col) * ((C)) + (tile_c)),\n        Some(__tile_map_mask), Some(T :: zeros :: < D > (& [BLOCK_N])), & [],\n        None, None, None, false,); let __tile_map_value =\n        {\n            let mean_b = T :: broadcast_to(mean.tensor, & [BLOCK_N]); let\n            rstd_b = T :: broadcast_to(rstd.tensor, & [BLOCK_N]); let gamma =\n            T :: broadcast_to(weight.tensor, & [BLOCK_N]); let beta = T ::\n            broadcast_to(bias.tensor, & [BLOCK_N]); gamma * (x - mean_b) *\n            rstd_b + beta\n        }; T ::\n        store(y.add_offsets((__tile_map_col) * ((C)) + (tile_c)),\n        __tile_map_value, Some(__tile_map_mask), & [], None, None,);\n        __tile_map_n += BLOCK_N;\n    }\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn batch_norm_normalize_forward_entry_point(x: *mut f32, y: *mut f32, weight: *mut f32, bias: *mut f32, mean: *mut f32, rstd: *mut f32, N: i32, C: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    let weight = LlvmPointer(weight as *mut _);\n    let bias = LlvmPointer(bias as *mut _);\n    let mean = LlvmPointer(mean as *mut _);\n    let rstd = LlvmPointer(rstd as *mut _);\n    batch_norm_normalize_forward::<LlvmTriton, f32, 128>(x, y, weight, bias, mean, rstd, N, C);\n}"
