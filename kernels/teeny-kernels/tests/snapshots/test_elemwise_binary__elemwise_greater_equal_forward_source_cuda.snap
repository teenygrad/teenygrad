"pub fn elemwise_greater_equal_forward < T : Triton, D : Num, const BLOCK_SIZE\n: i32 >\n(a : T :: Pointer < D > , b : T :: Pointer < D > , out : T :: Pointer < D > ,\nn_elements : i32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T ::\nI32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer <\nD > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer\n< D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let a = Tile :: < T,\n    D >\n    {\n        tensor : T ::\n        load(a.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let b = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(b.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < D > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; let cond =\n    T :: ge(a.tensor, b.tensor); let one = T :: cast :: < i32, D >\n    (T :: full :: < i32 > (& [BLOCK_SIZE], 1), None, false); let zero = T ::\n    zeros_like(a.tensor); T ::\n    store(out.tensor, T :: where_(cond, one, zero), a.mask, & [], None,\n    None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn elemwise_greater_equal_forward_entry_point(a: *mut f32, b: *mut f32, out: *mut f32, n_elements: i32) {\n    let a = LlvmPointer(a as *mut _);\n    let b = LlvmPointer(b as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    elemwise_greater_equal_forward::<LlvmTriton, f32, 1024>(a, b, out, n_elements);\n}"
