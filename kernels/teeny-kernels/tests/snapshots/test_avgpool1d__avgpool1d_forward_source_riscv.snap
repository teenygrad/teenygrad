"pub fn avgpool1d_forward < T : Triton, D : Num, const KL : i32, const STRIDE :\ni32, const BLOCK_OL : i32 >\n(input : T :: Pointer < D > , output : T :: Pointer < D > , _B : i32, C : i32,\nL : i32, OL : i32,) where T :: I32Tensor : Tensor < i32, 1 > , T :: I32Tensor\n: Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < D > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D >\n> > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ol =\n    __tile_rem_x % (T :: cdiv(OL, BLOCK_OL)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OL, BLOCK_OL)); let tile_c = __tile_rem_x % (C); __tile_rem_x =\n    __tile_rem_x / (C); let tile_b = __tile_rem_x; let __tile_range = T ::\n    arange(0, BLOCK_OL) + tile_ol * BLOCK_OL; let in_bounds =\n    __tile_range.lt(OL); let offsets = __tile_range + tile_b * (C * OL) +\n    tile_c * (OL); let output = Tile :: < T, T :: Pointer < D > >\n    { tensor : output.add_offsets(offsets), mask : Some(in_bounds), }; let mut\n    acc = T :: zeros :: < D > (& [BLOCK_OL]); for __tile_loop_idx in 0 ..\n    ((KL))\n    {\n        let _ = __tile_loop_idx; let mut __tile_loop_rem = __tile_loop_idx;\n        let kl = __tile_loop_rem; let input =\n        {\n            let __tile_read_mask = in_bounds; T ::\n            load(input.add_offsets(((__tile_range * STRIDE + kl)) +\n            ((tile_c) + (tile_b) * (C)) * (L)), Some(__tile_read_mask),\n            Some(T :: zeros :: < D > (& [BLOCK_OL])), & [], None, None, None,\n            false,)\n        }; acc = acc + input;\n    } let acc = acc / T ::\n    broadcast_to(T :: cast :: < i32, D >\n    (T :: full :: < i32 > (& [1], KL), None, false), & [BLOCK_OL]); T ::\n    store(output.tensor, acc, Some(in_bounds), & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn avgpool1d_forward_entry_point(input: *mut f32, output: *mut f32, _B: i32, C: i32, L: i32, OL: i32) {\n    let input = LlvmPointer(input as *mut _);\n    let output = LlvmPointer(output as *mut _);\n    avgpool1d_forward::<LlvmTriton, f32, 4, 4, 4>(input, output, _B, C, L, OL);\n}"
