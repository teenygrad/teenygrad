"pub fn margin_ranking_loss_forward < T : Triton, const BLOCK_SIZE : i32 >\n(x1 : T :: Pointer < f32 > , x2 : T :: Pointer < f32 > , y : T :: Pointer <\nf32 > , out : T :: Pointer < f32 > , n_elements : i32, margin : f32,) where T\n:: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32,\nBoolTensor = T :: BoolTensor > , T :: Pointer < f32 > : AddOffsets < i32, 1, T\n:: I32Tensor, Output = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let x1 = Tile :: < T,\n    f32 >\n    {\n        tensor : T ::\n        load(x1.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let x2 = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(x2.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(y.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < f32 > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; let zeros\n    = T :: zeros :: < f32 > (& [BLOCK_SIZE]); let margin_t = T ::\n    full(& [BLOCK_SIZE], margin); let neg_one = T ::\n    full(& [BLOCK_SIZE], - 1.0_f32); let hinge = T ::\n    maximum(neg_one * y.tensor * (x1.tensor - x2.tensor) + margin_t, zeros,);\n    T :: store(out.tensor, hinge, x1.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn margin_ranking_loss_forward_entry_point(x1: *mut f32, x2: *mut f32, y: *mut f32, out: *mut f32, n_elements: i32, margin: f32) {\n    let x1 = LlvmPointer(x1 as *mut _);\n    let x2 = LlvmPointer(x2 as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    margin_ranking_loss_forward::<LlvmTriton, 1024>(x1, x2, y, out, n_elements, margin);\n}"
