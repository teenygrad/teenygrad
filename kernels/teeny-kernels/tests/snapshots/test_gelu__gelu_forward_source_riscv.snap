"pub fn gelu_forward < T : Triton, D : Float, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , n_elements : i32,) where T\n:: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32,\nBoolTensor = T :: BoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T\n:: I32Tensor, Output = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let x = Tile :: < T,\n    D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let one = T\n    :: full(& [BLOCK_SIZE], D :: from_f64(1.0)); let neg2c = T ::\n    full(& [BLOCK_SIZE], D :: from_f64(- 2.0 * 0.7978845608028654)); let coeff\n    = T :: full(& [BLOCK_SIZE], D :: from_f64(0.044715)); let inner = x.tensor\n    + coeff * x.tensor * x.tensor * x.tensor; let out = x.tensor /\n    (one + T :: exp(neg2c * inner)); T ::\n    store(y.tensor, out, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn gelu_forward_entry_point(x: *mut f32, y: *mut f32, n_elements: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    gelu_forward::<LlvmTriton, f32, 128>(x, y, n_elements);\n}"
