"pub fn prelu_forward < T : Triton, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < f32 > , slope : T :: Pointer < f32 > , y : T :: Pointer <\nf32 > , n_elements : i32,) where T :: I32Tensor : types :: Tensor < i32, 1 > ,\nT :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nPointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor <\nT :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let x = Tile :: < T,\n    f32 >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let slope = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(slope.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < f32 > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let zero = T\n    :: zeros_like(x.tensor); let pos = T :: maximum(x.tensor, zero); let neg =\n    slope.tensor * T :: minimum(x.tensor, zero); T ::\n    store(y.tensor, pos + neg, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn prelu_forward_entry_point(x: *mut f32, slope: *mut f32, y: *mut f32, n_elements: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let slope = LlvmPointer(slope as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    prelu_forward::<LlvmTriton, 1024>(x, slope, y, n_elements);\n}"
