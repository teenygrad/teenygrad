"pub fn kl_div_loss_forward < T : Triton, const BLOCK_SIZE : i32 >\n(input : T :: Pointer < f32 > , target : T :: Pointer < f32 > , out : T ::\nPointer < f32 > , n_elements : i32,) where T :: I32Tensor : types :: Tensor <\ni32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > ,\nT :: Pointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor, Output = T ::\nTensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let input = Tile :: <\n    T, f32 >\n    {\n        tensor : T ::\n        load(input.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let target = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(target.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < f32 > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; let zeros\n    = T :: zeros :: < f32 > (& [BLOCK_SIZE]); let eps = T ::\n    full(& [BLOCK_SIZE], 1e-10_f32); let tgt_safe = T ::\n    maximum(target.tensor, eps); let loss_raw = target.tensor *\n    (T :: log(tgt_safe) - input.tensor); let positive = T ::\n    gt(target.tensor, zeros); let loss = T ::\n    where_(positive, loss_raw, zeros); T ::\n    store(out.tensor, loss, input.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn kl_div_loss_forward_entry_point(input: *mut f32, target: *mut f32, out: *mut f32, n_elements: i32) {\n    let input = LlvmPointer(input as *mut _);\n    let target = LlvmPointer(target as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    kl_div_loss_forward::<LlvmTriton, 1024>(input, target, out, n_elements);\n}"
