"pub fn conv1d_forward < T : Triton, D : Num, const KL : i32, const STRIDE :\ni32, const PAD : i32, const BLOCK_OL : i32, >\n(x : T :: Pointer < D > , w : T :: Pointer < D > , y : T :: Pointer < D > , _B\n: i32, C_IN : i32, C_OUT : i32, L : i32, OL : i32,) where T :: I32Tensor :\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: BoolTensor : BitAnd < Output = T :: BoolTensor > , T ::\nPointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T\n:: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ol =\n    __tile_rem_x % (T :: cdiv(OL, BLOCK_OL)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OL, BLOCK_OL)); let tile_c_out = __tile_rem_x % (C_OUT);\n    __tile_rem_x = __tile_rem_x / (C_OUT); let tile_b = __tile_rem_x; let\n    __tile_range = T :: arange(0, BLOCK_OL) + tile_ol * BLOCK_OL; let\n    in_bounds = __tile_range.lt(OL); let offsets = __tile_range + tile_b *\n    (C_OUT * OL) + tile_c_out * (OL); let y = Tile :: < T, T :: Pointer < D >\n    > { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let mut\n    acc = T :: zeros :: < D > (& [BLOCK_OL]); for __tile_loop_idx in 0 ..\n    ((C_IN) * (KL))\n    {\n        let _ = __tile_loop_idx; let mut __tile_loop_rem = __tile_loop_idx;\n        let kl = __tile_loop_rem % (KL); __tile_loop_rem = __tile_loop_rem /\n        (KL); let c_in = __tile_loop_rem; let w =\n        {\n            let __tile_scalar_off = T :: arange(0, 1) +\n            ((kl) + ((c_in) + (tile_c_out) * (C_IN)) * (KL)); T ::\n            broadcast_to(T ::\n            load(w.add_offsets(__tile_scalar_off), None, None, & [], None,\n            None, None, false,), & [BLOCK_OL],)\n        }; let x =\n        {\n            let __tile_coord_2 = (__tile_range * STRIDE + kl - PAD); let\n            __tile_read_mask = in_bounds &\n            (__tile_coord_2.ge(0) & __tile_coord_2.lt(L)); T ::\n            load(x.add_offsets(((__tile_range * STRIDE + kl - PAD)) +\n            ((c_in) + (tile_b) * (C_IN)) * (L)), Some(__tile_read_mask),\n            Some(T :: zeros :: < D > (& [BLOCK_OL])), & [], None, None, None,\n            false,)\n        }; acc = acc + x * w;\n    } T :: store(y.tensor, acc, Some(in_bounds), & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn conv1d_forward_entry_point(x: *mut f32, w: *mut f32, y: *mut f32, _B: i32, C_IN: i32, C_OUT: i32, L: i32, OL: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let w = LlvmPointer(w as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    conv1d_forward::<LlvmTriton, f32, 3, 1, 0, 8>(x, w, y, _B, C_IN, C_OUT, L, OL);\n}"
