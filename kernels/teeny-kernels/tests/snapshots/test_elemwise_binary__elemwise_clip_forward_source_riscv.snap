"pub fn elemwise_clip_forward < T : Triton, D : Float, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < D > , out : T :: Pointer < D > , n_elements : i32, min_val\n: f32, max_val : f32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T\n:: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer\n< D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T ::\nPointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let x = Tile :: < T,\n    D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < D > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; let lo = T\n    :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [BLOCK_SIZE], min_val), None, false); let hi = T\n    :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [BLOCK_SIZE], max_val), None, false); let y = T\n    :: clamp(x.tensor, lo, hi); T ::\n    store(out.tensor, y, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn elemwise_clip_forward_entry_point(x: *mut f32, out: *mut f32, n_elements: i32, min_val: f32, max_val: f32) {\n    let x = LlvmPointer(x as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    elemwise_clip_forward::<LlvmTriton, f32, 1024>(x, out, n_elements, min_val, max_val);\n}"
