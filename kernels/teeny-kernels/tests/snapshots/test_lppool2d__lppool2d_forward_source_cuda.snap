"pub fn lppool2d_forward < T : Triton, D : Float, const KH : i32, const KW :\ni32, const STRIDE_H : i32, const STRIDE_W : i32, const BLOCK_OW : i32, >\n(input : T :: Pointer < D > , output : T :: Pointer < D > , _B : i32, C : i32,\nH : i32, W : i32, OH : i32, OW : i32, p : f32,) where T :: I32Tensor : Tensor\n< i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor >\n, T :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T ::\nTensor < T :: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ow =\n    __tile_rem_x % (T :: cdiv(OW, BLOCK_OW)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OW, BLOCK_OW)); let tile_oh = __tile_rem_x % (OH); __tile_rem_x\n    = __tile_rem_x / (OH); let tile_c = __tile_rem_x % (C); __tile_rem_x =\n    __tile_rem_x / (C); let tile_b = __tile_rem_x; let __tile_range = T ::\n    arange(0, BLOCK_OW) + tile_ow * BLOCK_OW; let in_bounds =\n    __tile_range.lt(OW); let offsets = __tile_range + tile_b * (C * OH * OW) +\n    tile_c * (OH * OW) + tile_oh * (OW); let output = Tile :: < T, T ::\n    Pointer < D > >\n    { tensor : output.add_offsets(offsets), mask : Some(in_bounds), }; let mut\n    acc = T :: zeros :: < f32 > (& [BLOCK_OW]); for __tile_loop_idx in 0 ..\n    ((KH) * (KW))\n    {\n        let _ = __tile_loop_idx; let mut __tile_loop_rem = __tile_loop_idx;\n        let kw = __tile_loop_rem % (KW); __tile_loop_rem = __tile_loop_rem /\n        (KW); let kh = __tile_loop_rem; let input =\n        {\n            let __tile_read_mask = in_bounds; T ::\n            load(input.add_offsets(((__tile_range * STRIDE_W + kw)) +\n            (((tile_oh * STRIDE_H + kh)) + ((tile_c) + (tile_b) * (C)) * (H))\n            * (W)), Some(__tile_read_mask),\n            Some(T :: zeros :: < D > (& [BLOCK_OW])), & [], None, None, None,\n            false,)\n        }; acc = acc + T ::\n        exp(T :: full :: < f32 > (& [BLOCK_OW], p) * T ::\n        log(T ::\n        maximum(T :: abs(T :: cast :: < D, f32 > (input, None, false)), T ::\n        full :: < f32 > (& [BLOCK_OW], 1e-12_f32),)),);\n    } let acc = T :: cast :: < f32, D >\n    (T ::\n    exp(T ::\n    log(T :: maximum(acc, T :: full :: < f32 > (& [BLOCK_OW], 1e-12_f32))) * T\n    :: full :: < f32 > (& [BLOCK_OW], 1.0_f32 / p)), None, false); T ::\n    store(output.tensor, acc, Some(in_bounds), & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn lppool2d_forward_entry_point(input: *mut f32, output: *mut f32, _B: i32, C: i32, H: i32, W: i32, OH: i32, OW: i32, p: f32) {\n    let input = LlvmPointer(input as *mut _);\n    let output = LlvmPointer(output as *mut _);\n    lppool2d_forward::<LlvmTriton, f32, 2, 2, 2, 2, 4>(input, output, _B, C, H, W, OH, OW, p);\n}"
