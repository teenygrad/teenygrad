"pub fn elemwise_where_forward < T : Triton, D : Float, const BLOCK_SIZE : i32\n>\n(cond : T :: Pointer < D > , x : T :: Pointer < D > , y : T :: Pointer < D > ,\nout : T :: Pointer < D > , n_elements : i32,) where T :: I32Tensor : types ::\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let cond = Tile :: <\n    T, D >\n    {\n        tensor : T ::\n        load(cond.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let x = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(y.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < D > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; let zero =\n    T :: zeros_like(cond.tensor); let bool_cond = T :: ne(cond.tensor, zero);\n    T ::\n    store(out.tensor, T :: where_(bool_cond, x.tensor, y.tensor), cond.mask, &\n    [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn elemwise_where_forward_entry_point(cond: *mut f32, x: *mut f32, y: *mut f32, out: *mut f32, n_elements: i32) {\n    let cond = LlvmPointer(cond as *mut _);\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    elemwise_where_forward::<LlvmTriton, f32, 1024>(cond, x, y, out, n_elements);\n}"
