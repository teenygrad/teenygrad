"pub fn constant_pad3d_forward < T : Triton, D : Num, const PD1 : i32, const\nPD2 : i32, const PH1 : i32, const PH2 : i32, const PW1 : i32, const PW2 : i32,\nconst BLOCK_OW : i32, >\n(input : T :: Pointer < D > , output : T :: Pointer < D > , _B : i32, C : i32,\nDv : i32, H : i32, W : i32, OD : i32, OH : i32, OW : i32, value : f32,) where\nT :: I32Tensor : Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32,\nBoolTensor = T :: BoolTensor > , T :: BoolTensor : BitAnd < Output = T ::\nBoolTensor > , T :: BoolTensor : BitOr < Output = T :: BoolTensor > , T ::\nPointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T\n:: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ow =\n    __tile_rem_x % (T :: cdiv(OW, BLOCK_OW)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OW, BLOCK_OW)); let tile_oh = __tile_rem_x % (OH); __tile_rem_x\n    = __tile_rem_x / (OH); let tile_od = __tile_rem_x % (OD); __tile_rem_x =\n    __tile_rem_x / (OD); let tile_c = __tile_rem_x % (C); __tile_rem_x =\n    __tile_rem_x / (C); let tile_b = __tile_rem_x; let __tile_range = T ::\n    arange(0, BLOCK_OW) + tile_ow * BLOCK_OW; let in_bounds =\n    __tile_range.lt(OW); let offsets = __tile_range + tile_b *\n    (C * OD * OH * OW) + tile_c * (OD * OH * OW) + tile_od * (OH * OW) +\n    tile_oh * (OW); let __tile_win_input_2 = __tile_range * 0 +\n    ((tile_od) - (PD1)); let __tile_win_input_3 = __tile_range * 0 +\n    ((tile_oh) - (PH1)); let __tile_win_input_4 = (__tile_range) - (PW1); let\n    input = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(input.add_offsets((__tile_range) - (PW1) + tile_b *\n        (C * Dv * H * W) + tile_c * (Dv * H * W) + ((tile_od) - (PD1)) *\n        (H * W) + ((tile_oh) - (PH1)) * (W)),\n        Some(in_bounds &\n        (__tile_win_input_2.ge(0) & __tile_win_input_2.lt(Dv)) &\n        (__tile_win_input_3.ge(0) & __tile_win_input_3.lt(H)) &\n        (__tile_win_input_4.ge(0) & __tile_win_input_4.lt(W))),\n        Some(T :: cast :: < f32, D >\n        (T :: full :: < f32 > (& [BLOCK_OW], value), None, false,)), & [],\n        None, None, None, false,), mask :\n        Some(in_bounds &\n        (__tile_win_input_2.ge(0) & __tile_win_input_2.lt(Dv)) &\n        (__tile_win_input_3.ge(0) & __tile_win_input_3.lt(H)) &\n        (__tile_win_input_4.ge(0) & __tile_win_input_4.lt(W))),\n    }; let output = Tile :: < T, T :: Pointer < D > >\n    { tensor : output.add_offsets(offsets), mask : Some(in_bounds), }; T ::\n    store(output.tensor, input.tensor, output.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn constant_pad3d_forward_entry_point(input: *mut f32, output: *mut f32, _B: i32, C: i32, Dv: i32, H: i32, W: i32, OD: i32, OH: i32, OW: i32, value: f32) {\n    let input = LlvmPointer(input as *mut _);\n    let output = LlvmPointer(output as *mut _);\n    constant_pad3d_forward::<LlvmTriton, f32, 1, 1, 1, 2, 2, 2, 16>(input, output, _B, C, Dv, H, W, OD, OH, OW, value);\n}"
