"pub fn swish_forward < T : Triton, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < f32 > , y : T :: Pointer < f32 > , n_elements : i32,)\nwhere T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < f32 > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < f32\n> > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let x = Tile :: < T,\n    f32 >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < f32 > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let one = T\n    :: full :: < f32 > (& [BLOCK_SIZE], 1.0_f32); let neg1 = T :: full :: <\n    f32 > (& [BLOCK_SIZE], - 1.0_f32); let sig = one /\n    (one + T :: exp(neg1 * x.tensor)); let out = x.tensor * sig; T ::\n    store(y.tensor, out, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn swish_forward_entry_point(x: *mut f32, y: *mut f32, n_elements: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    swish_forward::<LlvmTriton, 1024>(x, y, n_elements);\n}"
