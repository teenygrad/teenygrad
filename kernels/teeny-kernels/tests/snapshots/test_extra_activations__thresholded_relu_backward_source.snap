"pub fn thresholded_relu_backward < T : Triton, const BLOCK_SIZE : i32 >\n(dy_ptr : T :: Pointer < f32 > , x_ptr : T :: Pointer < f32 > , dx_ptr : T ::\nPointer < f32 > , n_elements : i32, alpha : f32,) where T :: I32Tensor : types\n:: Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE;\n    let offsets = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let dy = T ::\n    load(dy_ptr.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n    None, false); let x = T ::\n    load(x_ptr.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n    None, false); let alpha_t = T :: full :: < f32 > (& [BLOCK_SIZE], alpha);\n    let above = T :: gt(x, alpha_t); let dx = T ::\n    where_(above, dy, T :: zeros_like(dy)); T ::\n    store(dx_ptr.add_offsets(offsets), dx, Some(in_bounds), & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn thresholded_relu_backward_entry_point(dy_ptr: *mut f32, x_ptr: *mut f32, dx_ptr: *mut f32, n_elements: i32, alpha: f32) {\n    let dy_ptr = LlvmPointer(dy_ptr as *mut _);\n    let x_ptr = LlvmPointer(x_ptr as *mut _);\n    let dx_ptr = LlvmPointer(dx_ptr as *mut _);\n    thresholded_relu_backward::<LlvmTriton, 1024>(dy_ptr, x_ptr, dx_ptr, n_elements, alpha);\n}"
