"pub fn psa_pack_qkv_backward < T : Triton, const KEY_DIM : i32 >\n(d_packed_ptr : T :: Pointer < f32 > , d_qkv_ptr : T :: Pointer < f32 > ,\nqkv_h : i32, H : i32, W : i32, B : i32, num_heads : i32,) where T :: I32Tensor\n: Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let BH = B * num_heads; let N = H *\n    W; let section = pid / (BH * N); let bh = (pid / N) % BH; let n = pid % N;\n    let b = bh / num_heads; let h = bh % num_heads; let d = T ::\n    arange(0, KEY_DIM); let src_base = section * BH * N * KEY_DIM + bh * N *\n    KEY_DIM + n * KEY_DIM; let dx = T ::\n    load(d_packed_ptr.add_offsets(d + src_base), None, None, & [], None, None,\n    None, false); let chan_base = h * 4 * KEY_DIM + section * KEY_DIM; let\n    dst_off = (d + chan_base) * (H * W) + (b * qkv_h * H * W + n); T ::\n    atomic_add(d_qkv_ptr.add_offsets(dst_off), dx, None, None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(d_packed_ptr: *mut f32, d_qkv_ptr: *mut f32, qkv_h: i32, H: i32, W: i32, B: i32, num_heads: i32) {\n    let d_packed_ptr = LlvmPointer(d_packed_ptr as *mut _);\n    let d_qkv_ptr = LlvmPointer(d_qkv_ptr as *mut _);\n    psa_pack_qkv_backward::<LlvmTriton, 4>(d_packed_ptr, d_qkv_ptr, qkv_h, H, W, B, num_heads);\n}"
