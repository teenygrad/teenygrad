"pub fn elu_forward < T : Triton, D : Float, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , n_elements : i32, alpha :\nf32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < D > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D >\n> > ,\n{\n    let pid = T :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE;\n    let offsets = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let x = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let one = T\n    :: full(& [BLOCK_SIZE], D :: from_f64(1.0)); let alpha_t = T ::\n    full(& [BLOCK_SIZE], D :: from_f64(alpha as f64)); let x_pos = T ::\n    gt(x.tensor, T :: zeros_like(x.tensor)); let elu = T ::\n    where_(x_pos, x.tensor, alpha_t * (T :: exp(x.tensor) - one)); T ::\n    store(y.tensor, elu, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn elu_forward_entry_point(x: *mut f32, y: *mut f32, n_elements: i32, alpha: f32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    elu_forward::<LlvmTriton, f32, 128>(x, y, n_elements, alpha);\n}"
