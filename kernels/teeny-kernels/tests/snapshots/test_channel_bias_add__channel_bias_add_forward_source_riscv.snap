"pub fn channel_bias_add_forward < T : Triton, D : Float, const BLOCK_N : i32 >\n(x : T :: Pointer < D > , bias : T :: Pointer < D > , y : T :: Pointer < D > ,\nN : i32, C : i32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T ::\nI32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer <\nD > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer\n< D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_c =\n    __tile_rem_x % (C); __tile_rem_x = __tile_rem_x / (C); let tile_n =\n    __tile_rem_x; let __tile_range = T :: arange(0, BLOCK_N) + tile_n *\n    BLOCK_N; let in_bounds = __tile_range.lt(N); let offsets = __tile_range *\n    (C) + tile_c; let x = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let bias = Tile :: < T, D >\n    {\n        tensor : T ::\n        broadcast_to(T ::\n        load(bias.add_offsets(T :: arange(0, 1) + tile_c), None, None, & [],\n        None, None, None, false,), & [BLOCK_N]), mask : None,\n    }; let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; T ::\n    store(y.tensor, x.tensor + bias.tensor, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn channel_bias_add_forward_entry_point(x: *mut f32, bias: *mut f32, y: *mut f32, N: i32, C: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let bias = LlvmPointer(bias as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    channel_bias_add_forward::<LlvmTriton, f32, 128>(x, bias, y, N, C);\n}"
