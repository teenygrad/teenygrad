"pub fn rms_norm_forward < T : Triton, D : Float, const BLOCK_N : i32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , weight : T :: Pointer < D >\n, rrms : T :: Pointer < D > , _M : i32, N : i32, eps : f32,) where T ::\nI32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32,\nBoolTensor = T :: BoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T\n:: I32Tensor, Output = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_n =\n    __tile_rem_x % (T :: cdiv(N, BLOCK_N)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(N, BLOCK_N)); let tile_m = __tile_rem_x; let __tile_range = T\n    :: arange(0, 1) + tile_m * 1; let in_bounds = __tile_range.lt(_M); let\n    offsets = __tile_range * (N) + tile_n; let rrms = Tile :: < T, T ::\n    Pointer < D > >\n    { tensor : rrms.add_offsets(__tile_range), mask : Some(in_bounds), }; let\n    mut sq_sum = T :: zeros :: < D > (& [1]); let mut __tile_pass_0 : i32 = 0;\n    while __tile_pass_0 < (N)\n    {\n        let __tile_pass_col_0 = T :: arange(0, BLOCK_N) + __tile_pass_0; let\n        __tile_pass_mask_0 = __tile_pass_col_0.lt(N); let x = T ::\n        load(x.add_offsets(__tile_pass_col_0 + (tile_m * (N))),\n        Some(__tile_pass_mask_0), Some(T :: zeros :: < D > (& [BLOCK_N])), &\n        [], None, None, None, false,); sq_sum = sq_sum +\n        (T :: sum(x * x, None, true)); __tile_pass_0 += BLOCK_N;\n    } let sq_sum = T ::\n    rsqrt(sq_sum * T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], 1.0f32 / (N as f32)), None, false) + T ::\n    cast :: < f32, D > (T :: full :: < f32 > (& [1], eps), None, false)); T ::\n    store(rrms.tensor, sq_sum, None, & [], None, None); let mut __tile_map_n :\n    i32 = 0; while __tile_map_n < (N)\n    {\n        let __tile_map_col = T :: arange(0, BLOCK_N) + __tile_map_n; let\n        __tile_map_mask = __tile_map_col.lt(N); let tile_walk =\n        __tile_map_col; let tile_walk_mask = __tile_map_mask; let x = T ::\n        load(x.add_offsets(__tile_map_col + (tile_m * (N))),\n        Some(__tile_map_mask), Some(T :: zeros :: < D > (& [BLOCK_N])), & [],\n        None, None, None, false,); let weight = T ::\n        load(weight.add_offsets(__tile_map_col), Some(__tile_map_mask),\n        Some(T :: zeros :: < D > (& [BLOCK_N])), & [], None, None, None,\n        false,); let __tile_map_value =\n        { x * T :: broadcast_to(sq_sum, & [BLOCK_N]) * weight }; T ::\n        store(y.add_offsets(__tile_map_col + (tile_m * (N))),\n        __tile_map_value, Some(__tile_map_mask), & [], None, None,);\n        __tile_map_n += BLOCK_N;\n    }\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn rms_norm_forward_entry_point(x: *mut f32, y: *mut f32, weight: *mut f32, rrms: *mut f32, _M: i32, N: i32, eps: f32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    let weight = LlvmPointer(weight as *mut _);\n    let rrms = LlvmPointer(rrms as *mut _);\n    rms_norm_forward::<LlvmTriton, f32, 256>(x, y, weight, rrms, _M, N, eps);\n}"
