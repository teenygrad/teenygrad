"pub fn gaussian_nll_loss_forward < T : Triton, const BLOCK_SIZE : i32 >\n(input : T :: Pointer < f32 > , target : T :: Pointer < f32 > , var : T ::\nPointer < f32 > , out : T :: Pointer < f32 > , n_elements : i32, eps_var :\nf32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < f32 > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < f32\n> > > ,\n{\n    let pid = T :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE;\n    let offsets = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let input = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(input.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let target = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(target.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let var = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(var.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < f32 > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; let zeros\n    = T :: zeros :: < f32 > (& [BLOCK_SIZE]); let eps_t = T ::\n    full(& [BLOCK_SIZE], eps_var); let half = T ::\n    full(& [BLOCK_SIZE], 0.5_f32); let var_c = T ::\n    maximum(var.tensor, eps_t); let diff = input.tensor - target.tensor; let\n    loss = half * (T :: log(var_c) + diff * diff / var_c); T ::\n    store(out.tensor, loss, input.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn gaussian_nll_loss_forward_entry_point(input: *mut f32, target: *mut f32, var: *mut f32, out: *mut f32, n_elements: i32, eps_var: f32) {\n    let input = LlvmPointer(input as *mut _);\n    let target = LlvmPointer(target as *mut _);\n    let var = LlvmPointer(var as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    gaussian_nll_loss_forward::<LlvmTriton, 1024>(input, target, var, out, n_elements, eps_var);\n}"
