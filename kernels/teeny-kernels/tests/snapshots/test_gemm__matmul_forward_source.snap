"pub fn matmul_forward < T : Triton, D : Float, const BLOCK_K : i32 >\n(a_ptr : T :: Pointer < D > , b_ptr : T :: Pointer < D > , c_ptr : T ::\nPointer < D > , M : i32, N : i32, K : i32,) where T :: I32Tensor : types ::\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let n = pid % N; let m = pid / N; if\n    m >= M { return; } let k_offsets = T :: arange(0, BLOCK_K); let a_offsets\n    = k_offsets + m * K; let k_mask = k_offsets.lt(K); let zero_fill = T ::\n    zeros :: < D > (& [BLOCK_K]); let a_row = T ::\n    load(a_ptr.add_offsets(a_offsets), Some(k_mask), Some(zero_fill), & [],\n    None, None, None, false,); let b_col_offsets = k_offsets * N + n; let\n    b_col_mask = k_offsets.lt(K); let b_col = T ::\n    load(b_ptr.add_offsets(b_col_offsets), Some(b_col_mask), Some(zero_fill),\n    & [], None, None, None, false,); let dot = T ::\n    sum(a_row * b_col, Some(0), true); let c_offset = T :: arange(0, 1) +\n    (m * N + n); T ::\n    store(c_ptr.add_offsets(c_offset), dot, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn matmul_forward_entry_point(a_ptr: *mut f32, b_ptr: *mut f32, c_ptr: *mut f32, M: i32, N: i32, K: i32) {\n    let a_ptr = LlvmPointer(a_ptr as *mut _);\n    let b_ptr = LlvmPointer(b_ptr as *mut _);\n    let c_ptr = LlvmPointer(c_ptr as *mut _);\n    matmul_forward::<LlvmTriton, f32, 128>(a_ptr, b_ptr, c_ptr, M, N, K);\n}"
