"pub fn maxpool2d_forward < T : Triton, D : Num, const KH : i32, const KW :\ni32, const STRIDE_H : i32, const STRIDE_W : i32, const PAD_H : i32, const\nPAD_W : i32, const BLOCK_OW : i32, >\n(input : T :: Pointer < D > , output : T :: Pointer < D > , _B : i32, C : i32,\nH : i32, W : i32, OH : i32, OW : i32,) where T :: I32Tensor : Tensor < i32, 1\n> , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nPointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T\n:: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ow =\n    __tile_rem_x % (T :: cdiv(OW, BLOCK_OW)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OW, BLOCK_OW)); let tile_oh = __tile_rem_x % (OH); __tile_rem_x\n    = __tile_rem_x / (OH); let tile_c = __tile_rem_x % (C); __tile_rem_x =\n    __tile_rem_x / (C); let tile_b = __tile_rem_x; let __tile_range = T ::\n    arange(0, BLOCK_OW) + tile_ow * BLOCK_OW; let in_bounds =\n    __tile_range.lt(OW); let offsets = __tile_range + tile_b * (C * OH * OW) +\n    tile_c * (OH * OW) + tile_oh * (OW); let output = Tile :: < T, T ::\n    Pointer < D > >\n    { tensor : output.add_offsets(offsets), mask : Some(in_bounds), }; let mut\n    acc = T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [BLOCK_OW], - 3.4028235e38_f32), None, false);\n    for __tile_loop_idx in 0 .. ((KH) * (KW))\n    {\n        let _ = __tile_loop_idx; let mut __tile_loop_rem = __tile_loop_idx;\n        let kw = __tile_loop_rem % (KW); __tile_loop_rem = __tile_loop_rem /\n        (KW); let kh = __tile_loop_rem; let input =\n        {\n            let __tile_coord_2 = __tile_range * 0 +\n            ((tile_oh * STRIDE_H + kh - PAD_H)); let __tile_coord_3 =\n            (__tile_range * STRIDE_W + kw - PAD_W); let __tile_read_mask =\n            in_bounds & (__tile_coord_2.ge(0) & __tile_coord_2.lt(H)) &\n            (__tile_coord_3.ge(0) & __tile_coord_3.lt(W)); T ::\n            load(input.add_offsets(((__tile_range * STRIDE_W + kw - PAD_W)) +\n            (((tile_oh * STRIDE_H + kh - PAD_H)) + ((tile_c) + (tile_b) * (C))\n            * (H)) * (W)), Some(__tile_read_mask),\n            Some(T :: cast :: < f32, D >\n            (T :: full :: < f32 > (& [BLOCK_OW], - 3.4028235e38_f32), None,\n            false,)), & [], None, None, None, false,)\n        }; acc = T :: maximum(acc, input);\n    } T :: store(output.tensor, acc, Some(in_bounds), & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn maxpool2d_forward_entry_point(input: *mut f32, output: *mut f32, _B: i32, C: i32, H: i32, W: i32, OH: i32, OW: i32) {\n    let input = LlvmPointer(input as *mut _);\n    let output = LlvmPointer(output as *mut _);\n    maxpool2d_forward::<LlvmTriton, f32, 2, 2, 2, 2, 0, 0, 4>(input, output, _B, C, H, W, OH, OW);\n}"
