"pub fn softplus_forward < T : Triton, D : Float, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , n_elements : i32, beta :\nf32, threshold : f32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T\n:: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer\n< D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T ::\nPointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE;\n    let offsets = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let x = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let beta_t =\n    T :: full(& [BLOCK_SIZE], D :: from_f64(beta as f64)); let inv_beta = T ::\n    full(& [BLOCK_SIZE], D :: from_f64(1.0 / beta as f64)); let thr = T ::\n    full(& [BLOCK_SIZE], D :: from_f64(threshold as f64)); let one = T ::\n    full(& [BLOCK_SIZE], D :: from_f64(1.0)); let bx = beta_t * x.tensor; let\n    above_thr = T :: gt(bx, thr); let y_safe = inv_beta * T ::\n    log(one + T :: exp(bx)); let out = T ::\n    where_(above_thr, x.tensor, y_safe); T ::\n    store(y.tensor, out, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn softplus_forward_entry_point(x: *mut f32, y: *mut f32, n_elements: i32, beta: f32, threshold: f32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    softplus_forward::<LlvmTriton, f32, 128>(x, y, n_elements, beta, threshold);\n}"
