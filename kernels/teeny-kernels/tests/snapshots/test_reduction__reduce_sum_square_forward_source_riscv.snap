"pub fn reduce_sum_square_forward < T : Triton, D : Num, const BLOCK_INNER :\ni32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , n_inner : i32, n_outer :\ni32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < D > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D >\n> > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_n_outer =\n    __tile_rem_x; let __tile_range = T :: arange(0, 1) + tile_n_outer * 1; let\n    in_bounds = __tile_range.lt(n_outer); let offsets = __tile_range; let\n    __tile_reduce_n_inner = T :: arange(0, BLOCK_INNER); let\n    __tile_reduce_mask_n_inner = __tile_reduce_n_inner.lt(n_inner); let x =\n    Tile :: < T, D >\n    {\n        tensor : T ::\n        load(x.add_offsets(__tile_range * (n_inner) + __tile_reduce_n_inner),\n        Some(__tile_reduce_mask_n_inner),\n        Some(T :: cast :: < f32, D >\n        (T :: full :: < f32 > (& [BLOCK_INNER], 0.0_f32), None, false,)), &\n        [], None, None, None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; T ::\n    store(y.tensor, T :: sum(x.tensor * x.tensor, Some(0), true), None, & [],\n    None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn reduce_sum_square_forward_entry_point(x: *mut f32, y: *mut f32, n_inner: i32, n_outer: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    reduce_sum_square_forward::<LlvmTriton, f32, 64>(x, y, n_inner, n_outer);\n}"
