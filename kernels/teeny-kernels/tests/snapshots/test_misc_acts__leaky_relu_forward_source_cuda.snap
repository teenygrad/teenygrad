"pub fn leaky_relu_forward < T : Triton, D : Float, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , n_elements : i32,\nnegative_slope : f32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T\n:: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer\n< D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T ::\nPointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_n_elements = pid; let\n    block_start = pid * BLOCK_SIZE; let offsets = T :: arange(0, BLOCK_SIZE) +\n    block_start; let in_bounds = offsets.lt(n_elements); let x = Tile :: < T,\n    D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let slope =\n    T :: full(& [BLOCK_SIZE], D :: from_f64(negative_slope as f64)); let x_pos\n    = T :: gt(x.tensor, T :: zeros_like(x.tensor)); let out = T ::\n    where_(x_pos, x.tensor, slope * x.tensor); T ::\n    store(y.tensor, out, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn leaky_relu_forward_entry_point(x: *mut f32, y: *mut f32, n_elements: i32, negative_slope: f32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    leaky_relu_forward::<LlvmTriton, f32, 128>(x, y, n_elements, negative_slope);\n}"
