"pub fn batch_norm_stats_forward < T : Triton, D : Float, const BLOCK_N : i32 >\n(x : T :: Pointer < D > , mean : T :: Pointer < D > , rstd : T :: Pointer < D\n> , running_mean_ptr : T :: Pointer < D > , running_var_ptr : T :: Pointer < D\n> , N : i32, C : i32, eps : f32, momentum : f32,) where T :: I32Tensor : types\n:: Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let tile_c = pid; let block_start =\n    pid * 1; let offsets = T :: arange(0, 1) + block_start; let in_bounds =\n    offsets.lt(C); let mean = Tile :: < T, T :: Pointer < D > >\n    { tensor : mean.add_offsets(offsets), mask : Some(in_bounds), }; let rstd\n    = Tile :: < T, T :: Pointer < D > >\n    { tensor : rstd.add_offsets(offsets), mask : Some(in_bounds), }; let mut\n    sum = T :: zeros :: < D > (& [1]); let mut sum_sq = T :: zeros :: < D >\n    (& [1]); let mut __tile_pass_0 : i32 = 0; while __tile_pass_0 < (N)\n    {\n        let __tile_pass_col_0 = T :: arange(0, BLOCK_N) + __tile_pass_0; let\n        __tile_pass_mask_0 = __tile_pass_col_0.lt(N); let x = T ::\n        load(x.add_offsets((__tile_pass_col_0) * ((C)) + (tile_c)),\n        Some(__tile_pass_mask_0), Some(T :: zeros :: < D > (& [BLOCK_N])), &\n        [], None, None, None, false,); sum = sum + (T :: sum(x, None, true));\n        sum_sq = sum_sq + (T :: sum(x * x, None, true)); __tile_pass_0 +=\n        BLOCK_N;\n    } let sum = sum * T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], 1.0f32 / (N as f32)), None, false); T ::\n    store(mean.tensor, sum, None, & [], None, None); let sum_sq = sum_sq * T\n    :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], 1.0f32 / (N as f32)), None, false) - sum *\n    sum; let c_idx = T :: arange(0, 1) + tile_c; let eps_t = T :: cast :: <\n    f32, D > (T :: full :: < f32 > (& [1], eps), None, false); T ::\n    store(rstd.tensor, T :: rsqrt(sum_sq + eps_t), None, & [], None, None);\n    let m = T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], momentum), None, false); let one_m = T ::\n    cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], 1.0f32 - momentum), None, false); let\n    running_mean_old = T ::\n    load(running_mean_ptr.add_offsets(c_idx), None, None, & [], None, None,\n    None, false,); let running_var_old = T ::\n    load(running_var_ptr.add_offsets(c_idx), None, None, & [], None, None,\n    None, false,); T ::\n    store(running_mean_ptr.add_offsets(c_idx), one_m * running_mean_old + m *\n    sum, None, & [], None, None,); T ::\n    store(running_var_ptr.add_offsets(c_idx), one_m * running_var_old + m *\n    sum_sq, None, & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn batch_norm_stats_forward_entry_point(x: *mut f32, mean: *mut f32, rstd: *mut f32, running_mean_ptr: *mut f32, running_var_ptr: *mut f32, N: i32, C: i32, eps: f32, momentum: f32) {\n    let x = LlvmPointer(x as *mut _);\n    let mean = LlvmPointer(mean as *mut _);\n    let rstd = LlvmPointer(rstd as *mut _);\n    let running_mean_ptr = LlvmPointer(running_mean_ptr as *mut _);\n    let running_var_ptr = LlvmPointer(running_var_ptr as *mut _);\n    batch_norm_stats_forward::<LlvmTriton, f32, 128>(x, mean, rstd, running_mean_ptr, running_var_ptr, N, C, eps, momentum);\n}"
