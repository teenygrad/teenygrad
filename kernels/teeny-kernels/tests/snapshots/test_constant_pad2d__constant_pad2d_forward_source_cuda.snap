"pub fn constant_pad2d_forward < T : Triton, D : Num, const PT : i32, const PB\n: i32, const PL : i32, const PR : i32, const BLOCK_OW : i32, >\n(input : T :: Pointer < D > , output : T :: Pointer < D > , _B : i32, C : i32,\nH : i32, W : i32, OH : i32, OW : i32, value : f32,) where T :: I32Tensor :\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: BoolTensor : BitAnd < Output = T :: BoolTensor > , T ::\nBoolTensor : BitOr < Output = T :: BoolTensor > , T :: Pointer < D > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D >\n> > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ow =\n    __tile_rem_x % (T :: cdiv(OW, BLOCK_OW)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OW, BLOCK_OW)); let tile_oh = __tile_rem_x % (OH); __tile_rem_x\n    = __tile_rem_x / (OH); let tile_c = __tile_rem_x % (C); __tile_rem_x =\n    __tile_rem_x / (C); let tile_b = __tile_rem_x; let __tile_range = T ::\n    arange(0, BLOCK_OW) + tile_ow * BLOCK_OW; let in_bounds =\n    __tile_range.lt(OW); let offsets = __tile_range + tile_b * (C * OH * OW) +\n    tile_c * (OH * OW) + tile_oh * (OW); let __tile_win_input_2 = __tile_range\n    * 0 + ((tile_oh) - (PT)); let __tile_win_input_3 = (__tile_range) - (PL);\n    let input = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(input.add_offsets((__tile_range) - (PL) + tile_b * (C * H * W) +\n        tile_c * (H * W) + ((tile_oh) - (PT)) * (W)),\n        Some(in_bounds & (__tile_win_input_2.ge(0) & __tile_win_input_2.lt(H))\n        & (__tile_win_input_3.ge(0) & __tile_win_input_3.lt(W))),\n        Some(T :: cast :: < f32, D >\n        (T :: full :: < f32 > (& [BLOCK_OW], value), None, false,)), & [],\n        None, None, None, false,), mask :\n        Some(in_bounds & (__tile_win_input_2.ge(0) & __tile_win_input_2.lt(H))\n        & (__tile_win_input_3.ge(0) & __tile_win_input_3.lt(W))),\n    }; let output = Tile :: < T, T :: Pointer < D > >\n    { tensor : output.add_offsets(offsets), mask : Some(in_bounds), }; T ::\n    store(output.tensor, input.tensor, output.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn constant_pad2d_forward_entry_point(input: *mut f32, output: *mut f32, _B: i32, C: i32, H: i32, W: i32, OH: i32, OW: i32, value: f32) {\n    let input = LlvmPointer(input as *mut _);\n    let output = LlvmPointer(output as *mut _);\n    constant_pad2d_forward::<LlvmTriton, f32, 1, 2, 2, 3, 16>(input, output, _B, C, H, W, OH, OW, value);\n}"
