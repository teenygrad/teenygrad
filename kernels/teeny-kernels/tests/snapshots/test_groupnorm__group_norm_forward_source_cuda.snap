"pub fn group_norm_forward < T : Triton, D : Float, const BLOCK_NL : i32 >\n(x : T :: Pointer < D > , y : T :: Pointer < D > , weight_ptr : T :: Pointer <\nD > , bias_ptr : T :: Pointer < D > , mean : T :: Pointer < D > , rstd : T ::\nPointer < D > , _N : i32, C : i32, L : i32, G : i32, group_size : i32, eps :\nf32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < D > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D >\n> > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_group_size =\n    __tile_rem_x % (T :: cdiv(group_size, BLOCK_NL)); __tile_rem_x =\n    __tile_rem_x / (T :: cdiv(group_size, BLOCK_NL)); let tile_g =\n    __tile_rem_x % (T :: cdiv(G, 1)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(G, 1)); let tile_n = __tile_rem_x; let __tile_range_0 = T ::\n    broadcast_to_i32(T ::\n    expand_dims_i32(T :: arange(0, 1) + tile_n * 1, 1i32), & [1, 1]); let\n    __tile_range_1 = T ::\n    broadcast_to_i32(T ::\n    expand_dims_i32(T :: arange(0, 1) + tile_g * 1, 0i32), & [1, 1]); let\n    in_bounds = __tile_range_0.lt(_N) & __tile_range_1.lt(G); let offsets =\n    __tile_range_0 * (G * group_size) + __tile_range_1 * (group_size) +\n    tile_group_size; let mean = Tile :: < T, T :: Pointer < D > >\n    {\n        tensor : mean.add_offsets(__tile_range_0 * (G) + __tile_range_1), mask\n        : Some(in_bounds),\n    }; let rstd = Tile :: < T, T :: Pointer < D > >\n    {\n        tensor : rstd.add_offsets(__tile_range_0 * (G) + __tile_range_1), mask\n        : Some(in_bounds),\n    }; let mut sum = T :: zeros :: < D > (& [1]); let mut __tile_pass_0 : i32\n    = 0; while __tile_pass_0 < (group_size)\n    {\n        let __tile_pass_col_0 = T :: arange(0, BLOCK_NL) + __tile_pass_0; let\n        __tile_pass_mask_0 = __tile_pass_col_0.lt(group_size); let x = T ::\n        load(x.add_offsets(__tile_pass_col_0 +\n        (tile_n * (G) * (group_size) + tile_g * (group_size))),\n        Some(__tile_pass_mask_0), Some(T :: zeros :: < D > (& [BLOCK_NL])), &\n        [], None, None, None, false,); sum = sum + (T :: sum(x, None, true));\n        __tile_pass_0 += BLOCK_NL;\n    } let sum = sum * T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], 1.0f32 / (group_size as f32)), None, false);\n    T ::\n    store(mean.tensor, T :: expand_dims(sum, 1i32), None, & [], None, None);\n    let mut var_sum = T :: zeros :: < D > (& [1]); let mut __tile_pass_1 : i32\n    = 0; while __tile_pass_1 < (group_size)\n    {\n        let __tile_pass_col_1 = T :: arange(0, BLOCK_NL) + __tile_pass_1; let\n        __tile_pass_mask_1 = __tile_pass_col_1.lt(group_size); let x = T ::\n        load(x.add_offsets(__tile_pass_col_1 +\n        (tile_n * (G) * (group_size) + tile_g * (group_size))),\n        Some(__tile_pass_mask_1), Some(T :: broadcast_to(sum, & [BLOCK_NL])),\n        & [], None, None, None, false,); var_sum = var_sum +\n        (T ::\n        sum((x - T :: broadcast_to(sum, & [BLOCK_NL])) *\n        (x - T :: broadcast_to(sum, & [BLOCK_NL])), None, true));\n        __tile_pass_1 += BLOCK_NL;\n    } let var_sum = T ::\n    rsqrt(var_sum * T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], 1.0f32 / (group_size as f32)), None, false)\n    + T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], eps), None, false)); T ::\n    store(rstd.tensor, T :: expand_dims(var_sum, 1i32), None, & [], None,\n    None); let mut __tile_map_n : i32 = 0; while __tile_map_n < (group_size)\n    {\n        let __tile_map_col = T :: arange(0, BLOCK_NL) + __tile_map_n; let\n        __tile_map_mask = __tile_map_col.lt(group_size); let tile_walk =\n        __tile_map_col; let tile_walk_mask = __tile_map_mask; let x = T ::\n        load(x.add_offsets(__tile_map_col +\n        (tile_n * (G) * (group_size) + tile_g * (group_size))),\n        Some(__tile_map_mask), Some(T :: zeros :: < D > (& [BLOCK_NL])), & [],\n        None, None, None, false,); let __tile_map_value =\n        {\n            let chan = tile_walk / L + tile_g * (C / G); let gamma = T ::\n            load(weight_ptr.add_offsets(chan), Some(tile_walk_mask),\n            Some(T :: zeros :: < D > (& [BLOCK_NL])), & [], None, None, None,\n            false,); let beta = T ::\n            load(bias_ptr.add_offsets(chan), Some(tile_walk_mask),\n            Some(T :: zeros :: < D > (& [BLOCK_NL])), & [], None, None, None,\n            false,); (x - T :: broadcast_to(sum, & [BLOCK_NL])) * T ::\n            broadcast_to(var_sum, & [BLOCK_NL]) * gamma + beta\n        }; T ::\n        store(y.add_offsets(__tile_map_col +\n        (tile_n * (G) * (group_size) + tile_g * (group_size))),\n        __tile_map_value, Some(__tile_map_mask), & [], None, None,);\n        __tile_map_n += BLOCK_NL;\n    }\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn group_norm_forward_entry_point(x: *mut f32, y: *mut f32, weight_ptr: *mut f32, bias_ptr: *mut f32, mean: *mut f32, rstd: *mut f32, _N: i32, C: i32, L: i32, G: i32, group_size: i32, eps: f32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    let weight_ptr = LlvmPointer(weight_ptr as *mut _);\n    let bias_ptr = LlvmPointer(bias_ptr as *mut _);\n    let mean = LlvmPointer(mean as *mut _);\n    let rstd = LlvmPointer(rstd as *mut _);\n    group_norm_forward::<LlvmTriton, f32, 256>(x, y, weight_ptr, bias_ptr, mean, rstd, _N, C, L, G, group_size, eps);\n}"
