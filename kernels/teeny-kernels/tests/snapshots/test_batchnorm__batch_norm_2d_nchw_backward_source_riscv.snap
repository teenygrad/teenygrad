"pub fn batch_norm_2d_nchw_backward < T : Triton, D : Float, const BLOCK_HW :\ni32 >\n(dy_ptr : T :: Pointer < D > , x_ptr : T :: Pointer < D > , dx_ptr : T ::\nPointer < D > , weight_ptr : T :: Pointer < D > , running_mean_ptr : T ::\nPointer < D > , running_var_ptr : T :: Pointer < D > , dweight_ptr : T ::\nPointer < D > , dbias_ptr : T :: Pointer < D > , B : i32, C : i32, HW : i32,\neps : f32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor\n: Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < D > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D >\n> > ,\n{\n    let c = T :: program_id(Axis :: X); let c_idx = T :: arange(0, 1) + c; let\n    mean = T ::\n    load(running_mean_ptr.add_offsets(c_idx), None, None, & [], None, None,\n    None, false,); let var = T ::\n    load(running_var_ptr.add_offsets(c_idx), None, None, & [], None, None,\n    None, false,); let rstd = T ::\n    rsqrt(var + T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [1], eps), None, false)); let gamma = T ::\n    load(weight_ptr.add_offsets(c_idx), None, None, & [], None, None, None,\n    false,); let mut sum_dy = T :: zeros :: < D > (& [1]); let mut sum_dy_xhat\n    = T :: zeros :: < D > (& [1]); let total_bhw = B * HW; let mut n : i32 =\n    0; while n < total_bhw\n    {\n        let b_idx = n / HW; let hw_idx = n % HW; let offset : i32 = b_idx * C\n        * HW + c * HW + hw_idx; let off_1 = T :: arange(0, 1) + offset; let\n        x_elem = T ::\n        load(x_ptr.add_offsets(off_1), None, None, & [], None, None, None,\n        false,); let dy_elem = T ::\n        load(dy_ptr.add_offsets(off_1), None, None, & [], None, None, None,\n        false,); let xhat = (x_elem - mean) * rstd; sum_dy = sum_dy + dy_elem;\n        sum_dy_xhat = sum_dy_xhat + dy_elem * xhat; let dx_elem = gamma * rstd\n        * dy_elem; T ::\n        store(dx_ptr.add_offsets(off_1), dx_elem, None, & [], None, None); n\n        += 1;\n    } T ::\n    store(dweight_ptr.add_offsets(c_idx), sum_dy_xhat, None, & [], None,\n    None,); T ::\n    store(dbias_ptr.add_offsets(c_idx), sum_dy, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn batch_norm_2d_nchw_backward_entry_point(dy_ptr: *mut f32, x_ptr: *mut f32, dx_ptr: *mut f32, weight_ptr: *mut f32, running_mean_ptr: *mut f32, running_var_ptr: *mut f32, dweight_ptr: *mut f32, dbias_ptr: *mut f32, B: i32, C: i32, HW: i32, eps: f32) {\n    let dy_ptr = LlvmPointer(dy_ptr as *mut _);\n    let x_ptr = LlvmPointer(x_ptr as *mut _);\n    let dx_ptr = LlvmPointer(dx_ptr as *mut _);\n    let weight_ptr = LlvmPointer(weight_ptr as *mut _);\n    let running_mean_ptr = LlvmPointer(running_mean_ptr as *mut _);\n    let running_var_ptr = LlvmPointer(running_var_ptr as *mut _);\n    let dweight_ptr = LlvmPointer(dweight_ptr as *mut _);\n    let dbias_ptr = LlvmPointer(dbias_ptr as *mut _);\n    batch_norm_2d_nchw_backward::<LlvmTriton, f32, 128>(dy_ptr, x_ptr, dx_ptr, weight_ptr, running_mean_ptr, running_var_ptr, dweight_ptr, dbias_ptr, B, C, HW, eps);\n}"
