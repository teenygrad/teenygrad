"pub fn conv3d_forward < T : Triton, D : Num, const KD : i32, const KH : i32,\nconst KW : i32, const STRIDE_D : i32, const STRIDE_H : i32, const STRIDE_W :\ni32, const PAD_D : i32, const PAD_H : i32, const PAD_W : i32, const BLOCK_OW :\ni32, >\n(x : T :: Pointer < D > , w : T :: Pointer < D > , y : T :: Pointer < D > , _B\n: i32, C_IN : i32, C_OUT : i32, Dv : i32, H : i32, W : i32, OD : i32, OH :\ni32, OW : i32,) where T :: I32Tensor : Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: BoolTensor : BitAnd <\nOutput = T :: BoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T ::\nI32Tensor, Output = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ow =\n    __tile_rem_x % (T :: cdiv(OW, BLOCK_OW)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OW, BLOCK_OW)); let tile_oh = __tile_rem_x % (OH); __tile_rem_x\n    = __tile_rem_x / (OH); let tile_od = __tile_rem_x % (OD); __tile_rem_x =\n    __tile_rem_x / (OD); let tile_c_out = __tile_rem_x % (C_OUT); __tile_rem_x\n    = __tile_rem_x / (C_OUT); let tile_b = __tile_rem_x; let __tile_range = T\n    :: arange(0, BLOCK_OW) + tile_ow * BLOCK_OW; let in_bounds =\n    __tile_range.lt(OW); let offsets = __tile_range + tile_b *\n    (C_OUT * OD * OH * OW) + tile_c_out * (OD * OH * OW) + tile_od * (OH * OW)\n    + tile_oh * (OW); let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let mut acc\n    = T :: zeros :: < D > (& [BLOCK_OW]); for __tile_loop_idx in 0 ..\n    ((C_IN) * (KD) * (KH) * (KW))\n    {\n        let _ = __tile_loop_idx; let mut __tile_loop_rem = __tile_loop_idx;\n        let kw = __tile_loop_rem % (KW); __tile_loop_rem = __tile_loop_rem /\n        (KW); let kh = __tile_loop_rem % (KH); __tile_loop_rem =\n        __tile_loop_rem / (KH); let kd = __tile_loop_rem % (KD);\n        __tile_loop_rem = __tile_loop_rem / (KD); let c_in = __tile_loop_rem;\n        let w =\n        {\n            let __tile_scalar_off = T :: arange(0, 1) +\n            ((kw) +\n            ((kh) + ((kd) + ((c_in) + (tile_c_out) * (C_IN)) * (KD)) * (KH)) *\n            (KW)); T ::\n            broadcast_to(T ::\n            load(w.add_offsets(__tile_scalar_off), None, None, & [], None,\n            None, None, false,), & [BLOCK_OW],)\n        }; let x =\n        {\n            let __tile_coord_2 = __tile_range * 0 +\n            ((tile_od * STRIDE_D + kd - PAD_D)); let __tile_coord_3 =\n            __tile_range * 0 + ((tile_oh * STRIDE_H + kh - PAD_H)); let\n            __tile_coord_4 = (__tile_range * STRIDE_W + kw - PAD_W); let\n            __tile_read_mask = in_bounds &\n            (__tile_coord_2.ge(0) & __tile_coord_2.lt(Dv)) &\n            (__tile_coord_3.ge(0) & __tile_coord_3.lt(H)) &\n            (__tile_coord_4.ge(0) & __tile_coord_4.lt(W)); T ::\n            load(x.add_offsets(((__tile_range * STRIDE_W + kw - PAD_W)) +\n            (((tile_oh * STRIDE_H + kh - PAD_H)) +\n            (((tile_od * STRIDE_D + kd - PAD_D)) +\n            ((c_in) + (tile_b) * (C_IN)) * (Dv)) * (H)) * (W)),\n            Some(__tile_read_mask), Some(T :: zeros :: < D > (& [BLOCK_OW])),\n            & [], None, None, None, false,)\n        }; acc = acc + x * w;\n    } T :: store(y.tensor, acc, Some(in_bounds), & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn conv3d_forward_entry_point(x: *mut f32, w: *mut f32, y: *mut f32, _B: i32, C_IN: i32, C_OUT: i32, Dv: i32, H: i32, W: i32, OD: i32, OH: i32, OW: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let w = LlvmPointer(w as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    conv3d_forward::<LlvmTriton, f32, 2, 2, 3, 1, 1, 1, 0, 0, 0, 8>(x, w, y, _B, C_IN, C_OUT, Dv, H, W, OD, OH, OW);\n}"
