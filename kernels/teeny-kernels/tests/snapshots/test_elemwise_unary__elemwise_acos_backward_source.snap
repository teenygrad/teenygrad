"pub fn elemwise_acos_backward < T : Triton, D : Float, const BLOCK_SIZE : i32\n>\n(dy_ptr : T :: Pointer < D > , x_ptr : T :: Pointer < D > , dx_ptr : T ::\nPointer < D > , n_elements : i32,) where T :: I32Tensor : types :: Tensor <\ni32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > ,\nT :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor\n< T :: Pointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE;\n    let offsets = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let dy = T ::\n    load(dy_ptr.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n    None, false); let x = T ::\n    load(x_ptr.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n    None, false); let one = T :: cast :: < f32, D >\n    (T :: full :: < f32 > (& [BLOCK_SIZE], 1.0_f32), None, false); let dx = -\n    (dy / T :: sqrt(one - x * x)); T ::\n    store(dx_ptr.add_offsets(offsets), dx, Some(in_bounds), & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn elemwise_acos_backward_entry_point(dy_ptr: *mut f32, x_ptr: *mut f32, dx_ptr: *mut f32, n_elements: i32) {\n    let dy_ptr = LlvmPointer(dy_ptr as *mut _);\n    let x_ptr = LlvmPointer(x_ptr as *mut _);\n    let dx_ptr = LlvmPointer(dx_ptr as *mut _);\n    elemwise_acos_backward::<LlvmTriton, f32, 1024>(dy_ptr, x_ptr, dx_ptr, n_elements);\n}"
