"pub fn log_softmax_forward < T : Triton, const BLOCK_SIZE : i32 >\n(x : T :: Pointer < f32 > , y : T :: Pointer < f32 > , _n_rows : i32, n_cols :\ni32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < f32 > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < f32\n> > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_n_cols =\n    __tile_rem_x % (T :: cdiv(n_cols, BLOCK_SIZE)); __tile_rem_x =\n    __tile_rem_x / (T :: cdiv(n_cols, BLOCK_SIZE)); let tile_n_rows =\n    __tile_rem_x; let __tile_range = T :: arange(0, BLOCK_SIZE) + tile_n_cols\n    * BLOCK_SIZE; let in_bounds = __tile_range.lt(n_cols); let offsets =\n    __tile_range + tile_n_rows * (n_cols); let x = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, T :: Pointer < f32 > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; let m = T ::\n    max(x.tensor, Some(0), true); let x_m = x.tensor - m; let log_sum = T ::\n    log(T :: sum(T :: exp(x_m), Some(0), true)); T ::\n    store(y.tensor, x_m - log_sum, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn log_softmax_forward_entry_point(x: *mut f32, y: *mut f32, _n_rows: i32, n_cols: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    log_softmax_forward::<LlvmTriton, 128>(x, y, _n_rows, n_cols);\n}"
