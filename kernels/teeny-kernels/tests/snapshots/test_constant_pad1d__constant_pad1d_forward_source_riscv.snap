"pub fn constant_pad1d_forward < T : Triton, D : Num, const PAD_LEFT : i32,\nconst PAD_RIGHT : i32, const BLOCK_OL : i32, >\n(input : T :: Pointer < D > , output : T :: Pointer < D > , _B : i32, C : i32,\nL : i32, OL : i32, value : f32,) where T :: I32Tensor : Tensor < i32, 1 > , T\n:: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nBoolTensor : BitAnd < Output = T :: BoolTensor > , T :: BoolTensor : BitOr <\nOutput = T :: BoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T ::\nI32Tensor, Output = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let mut __tile_rem_x = T :: program_id(Axis :: X); let tile_ol =\n    __tile_rem_x % (T :: cdiv(OL, BLOCK_OL)); __tile_rem_x = __tile_rem_x /\n    (T :: cdiv(OL, BLOCK_OL)); let tile_c = __tile_rem_x % (C); __tile_rem_x =\n    __tile_rem_x / (C); let tile_b = __tile_rem_x; let __tile_range = T ::\n    arange(0, BLOCK_OL) + tile_ol * BLOCK_OL; let in_bounds =\n    __tile_range.lt(OL); let offsets = __tile_range + tile_b * (C * OL) +\n    tile_c * (OL); let __tile_win_input_2 = (__tile_range) - (PAD_LEFT); let\n    input = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(input.add_offsets((__tile_range) - (PAD_LEFT) + tile_b * (C * L)\n        + tile_c * (L)),\n        Some(in_bounds &\n        (__tile_win_input_2.ge(0) & __tile_win_input_2.lt(L))),\n        Some(T :: cast :: < f32, D >\n        (T :: full :: < f32 > (& [BLOCK_OL], value), None, false,)), & [],\n        None, None, None, false,), mask :\n        Some(in_bounds &\n        (__tile_win_input_2.ge(0) & __tile_win_input_2.lt(L))),\n    }; let output = Tile :: < T, T :: Pointer < D > >\n    { tensor : output.add_offsets(offsets), mask : Some(in_bounds), }; T ::\n    store(output.tensor, input.tensor, output.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn constant_pad1d_forward_entry_point(input: *mut f32, output: *mut f32, _B: i32, C: i32, L: i32, OL: i32, value: f32) {\n    let input = LlvmPointer(input as *mut _);\n    let output = LlvmPointer(output as *mut _);\n    constant_pad1d_forward::<LlvmTriton, f32, 2, 3, 16>(input, output, _B, C, L, OL, value);\n}"
