"pub fn hinge_embedding_loss_forward < T : Triton, const BLOCK_SIZE : i32 >\n(inp : T :: Pointer < f32 > , y : T :: Pointer < f32 > , out : T :: Pointer <\nf32 > , n_elements : i32, margin : f32,) where T :: I32Tensor : types ::\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE;\n    let offsets = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let inp = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(inp.add_offsets(offsets), Some(in_bounds), None, & [], None,\n        None, None, false,), mask : Some(in_bounds),\n    }; let y = Tile :: < T, f32 >\n    {\n        tensor : T ::\n        load(y.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < f32 > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; let zeros\n    = T :: zeros :: < f32 > (& [BLOCK_SIZE]); let margin_t = T ::\n    full(& [BLOCK_SIZE], margin); let y_is_pos = T :: gt(y.tensor, zeros); let\n    hinge = T :: maximum(margin_t - inp.tensor, zeros); let result = T ::\n    where_(y_is_pos, inp.tensor, hinge); T ::\n    store(out.tensor, result, inp.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn hinge_embedding_loss_forward_entry_point(inp: *mut f32, y: *mut f32, out: *mut f32, n_elements: i32, margin: f32) {\n    let inp = LlvmPointer(inp as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    hinge_embedding_loss_forward::<LlvmTriton, 1024>(inp, y, out, n_elements, margin);\n}"
