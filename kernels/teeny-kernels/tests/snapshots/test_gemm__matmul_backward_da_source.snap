"pub fn matmul_backward_da < T : Triton, D : Float, const BLOCK_N : i32 >\n(dc_ptr : T :: Pointer < D > , b_ptr : T :: Pointer < D > , da_ptr : T ::\nPointer < D > , M : i32, N : i32, K : i32,) where T :: I32Tensor : types ::\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let k = pid % K; let m = pid / K; if\n    m >= M { return; } let n_offsets = T :: arange(0, BLOCK_N); let dc_offsets\n    = n_offsets + m * N; let n_mask = n_offsets.lt(N); let zero_fill = T ::\n    zeros :: < D > (& [BLOCK_N]); let dc_row = T ::\n    load(dc_ptr.add_offsets(dc_offsets), Some(n_mask), Some(zero_fill), & [],\n    None, None, None, false,); let b_row_offsets = n_offsets + k * N; let\n    b_row = T ::\n    load(b_ptr.add_offsets(b_row_offsets), Some(n_mask), Some(zero_fill), &\n    [], None, None, None, false,); let dot = T ::\n    sum(dc_row * b_row, Some(0), true); let da_offset = T :: arange(0, 1) +\n    (m * K + k); T ::\n    store(da_ptr.add_offsets(da_offset), dot, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn matmul_backward_da_entry_point(dc_ptr: *mut f32, b_ptr: *mut f32, da_ptr: *mut f32, M: i32, N: i32, K: i32) {\n    let dc_ptr = LlvmPointer(dc_ptr as *mut _);\n    let b_ptr = LlvmPointer(b_ptr as *mut _);\n    let da_ptr = LlvmPointer(da_ptr as *mut _);\n    matmul_backward_da::<LlvmTriton, f32, 128>(dc_ptr, b_ptr, da_ptr, M, N, K);\n}"
