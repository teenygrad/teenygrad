"pub fn nchw_bias_add_forward < T : Triton, D : Float, const BLOCK_HW : i32 >\n(x : T :: Pointer < D > , bias : T :: Pointer < D > , y : T :: Pointer < D > ,\nB : i32, C : i32, HW : i32,) where T :: I32Tensor : types :: Tensor < i32, 1 >\n, T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nPointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T\n:: Pointer < D > > > ,\n{\n    let mut __tile_rem_y = T :: program_id(Axis :: Y); let tile_b =\n    __tile_rem_y; let mut __tile_rem_x = T :: program_id(Axis :: X); let\n    tile_hw = __tile_rem_x % (T :: cdiv(HW, BLOCK_HW)); __tile_rem_x =\n    __tile_rem_x / (T :: cdiv(HW, BLOCK_HW)); let tile_c = __tile_rem_x; let\n    __tile_range = T :: arange(0, BLOCK_HW) + tile_hw * BLOCK_HW; let\n    in_bounds = __tile_range.lt(HW); let offsets = __tile_range + tile_b *\n    (C * HW) + tile_c * (HW); let x = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(x.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let bias = Tile :: < T, D >\n    {\n        tensor : T ::\n        broadcast_to(T ::\n        load(bias.add_offsets(T :: arange(0, 1) + tile_c), None, None, & [],\n        None, None, None, false,), & [BLOCK_HW]), mask : None,\n    }; let y = Tile :: < T, T :: Pointer < D > >\n    { tensor : y.add_offsets(offsets), mask : Some(in_bounds), }; T ::\n    store(y.tensor, x.tensor + bias.tensor, x.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn nchw_bias_add_forward_entry_point(x: *mut f32, bias: *mut f32, y: *mut f32, B: i32, C: i32, HW: i32) {\n    let x = LlvmPointer(x as *mut _);\n    let bias = LlvmPointer(bias as *mut _);\n    let y = LlvmPointer(y as *mut _);\n    nchw_bias_add_forward::<LlvmTriton, f32, 128>(x, bias, y, B, C, HW);\n}"
