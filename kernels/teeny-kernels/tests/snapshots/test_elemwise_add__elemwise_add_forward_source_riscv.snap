"pub fn elemwise_add_forward < T : Triton, D : Num, const BLOCK_SIZE : i32 >\n(a : T :: Pointer < D > , b : T :: Pointer < D > , out : T :: Pointer < D > ,\nn_elements : i32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T ::\nI32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer <\nD > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer\n< D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE;\n    let offsets = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let a = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(a.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let b = Tile :: < T, D >\n    {\n        tensor : T ::\n        load(b.add_offsets(offsets), Some(in_bounds), None, & [], None, None,\n        None, false,), mask : Some(in_bounds),\n    }; let out = Tile :: < T, T :: Pointer < D > >\n    { tensor : out.add_offsets(offsets), mask : Some(in_bounds), }; T ::\n    store(out.tensor, a.tensor + b.tensor, a.mask, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn elemwise_add_forward_entry_point(a: *mut f32, b: *mut f32, out: *mut f32, n_elements: i32) {\n    let a = LlvmPointer(a as *mut _);\n    let b = LlvmPointer(b as *mut _);\n    let out = LlvmPointer(out as *mut _);\n    elemwise_add_forward::<LlvmTriton, f32, 128>(a, b, out, n_elements);\n}"
