"fn tile_layout_boundary_enum_probe < T : Triton, D : Num, const BLOCK_SIZE :\ni32 >\n(x_ptr : T :: Pointer < D > , y_ptr : T :: Pointer < D > , n_elements : i32,)\nwhere T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < D > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D >\n> > ,\n{\n    #[doc =\n    \" How an out-of-range coordinate on this axis is resolved. `Zero`\"]\n    #[doc = \" masks the load (today\\'s behavior); `Clamp` would fold the\"]\n    #[doc = \" coordinate instead -- this probe only needs two variants to\"]\n    #[doc = \" exercise a real multi-arm `match`, not full coverage.\"] enum\n    BoundaryMode { Zero, Clamp, }\n    #[doc =\n    \" Local items don\\'t inherit the enclosing function\\'s generics (see\"]\n    #[doc =\n    \" `test_kitchen_sink.rs`\\'s nested `combine_num`), so this declares\"]\n    #[doc = \" its own `TT`/`DD`.\"] struct BoundaryTile < TT : Triton, DD : Num\n    > { base : TT :: Pointer < DD > , boundary : BoundaryMode, } let pid = T\n    :: program_id(Axis :: X); let block_start = pid * BLOCK_SIZE; let offsets\n    = T :: arange(0, BLOCK_SIZE) + block_start; let in_bounds =\n    offsets.lt(n_elements); let tile = BoundaryTile :: < T, D >\n    { base : x_ptr, boundary : BoundaryMode :: Zero, }; let default = match\n    tile.boundary\n    {\n        BoundaryMode :: Zero => T :: zeros :: < D > (& [BLOCK_SIZE]),\n        BoundaryMode :: Clamp => T :: zeros :: < D > (& [BLOCK_SIZE]),\n    }; let x = T ::\n    load(tile.base.add_offsets(offsets), Some(in_bounds), Some(default), & [],\n    None, None, None, false,); T ::\n    store(y_ptr.add_offsets(offsets), x, Some(in_bounds), & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn tile_layout_boundary_enum_probe_entry_point(x_ptr: *mut f32, y_ptr: *mut f32, n_elements: i32) {\n    let x_ptr = LlvmPointer(x_ptr as *mut _);\n    let y_ptr = LlvmPointer(y_ptr as *mut _);\n    tile_layout_boundary_enum_probe::<LlvmTriton, f32, 1024>(x_ptr, y_ptr, n_elements);\n}"
