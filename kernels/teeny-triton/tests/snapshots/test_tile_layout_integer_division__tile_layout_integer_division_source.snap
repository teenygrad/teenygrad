"fn tile_layout_integer_division_probe < T : Triton, D : Num, const BLOCK_SIZE\n: i32 >\n(x_ptr : T :: Pointer < D > , y_ptr : T :: Pointer < D > , n_elements : i32,\ndivisor : i32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T ::\nI32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer <\nD > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer\n< D > > > ,\n{\n    #[doc =\n    \" Local items don\\'t inherit the enclosing function\\'s generics (see\"]\n    #[doc =\n    \" `test_kitchen_sink.rs`\\'s nested `combine_num`), so this declares\"]\n    #[doc = \" its own `TT`/`DD`.\"] struct DivTile < TT : Triton, DD : Num >\n    { base : TT :: Pointer < DD > , divisor : i32, } let pid = T ::\n    program_id(Axis :: X); let block_start = pid * BLOCK_SIZE; let tile =\n    DivTile :: < T, D > { base : x_ptr, divisor, }; let scaled_start =\n    block_start / tile.divisor; let offsets = T :: arange(0, BLOCK_SIZE) +\n    scaled_start; let in_bounds = offsets.lt(n_elements); let x = T ::\n    load(tile.base.add_offsets(offsets), Some(in_bounds), None, & [], None,\n    None, None, false,); T ::\n    store(y_ptr.add_offsets(offsets), x, Some(in_bounds), & [], None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn tile_layout_integer_division_probe_entry_point(x_ptr: *mut f32, y_ptr: *mut f32, n_elements: i32, divisor: i32) {\n    let x_ptr = LlvmPointer(x_ptr as *mut _);\n    let y_ptr = LlvmPointer(y_ptr as *mut _);\n    tile_layout_integer_division_probe::<LlvmTriton, f32, 1024>(x_ptr, y_ptr, n_elements, divisor);\n}"
